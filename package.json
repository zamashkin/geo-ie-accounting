{
  "name": "ie-ledger",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:init": "node scripts/init-env.mjs",
    "db:generate": "pnpm --filter @ie-ledger/db db:generate",
    "db:migrate": "pnpm --filter @ie-ledger/db db:migrate",
    "db:seed": "pnpm --filter @ie-ledger/db db:seed",
    "gen:api": "pnpm --filter @ie-ledger/api openapi && pnpm --filter @ie-ledger/web gen:api",
    "e2e": "pnpm --filter @ie-ledger/web e2e"
  },
  "prettier": "@ie-ledger/config/prettier",
  "devDependencies": {
    "@ie-ledger/config": "workspace:*",
    "prettier": "3.9.10",
    "turbo": "2.11.8",
    "typescript": "6.0.3"
  }
}
