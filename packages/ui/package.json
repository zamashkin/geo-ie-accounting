{
  "name": "@geo-ie-accounting/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design-system components. No app logic.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@geo-ie-accounting/domain": "workspace:*",
    "@internationalized/date": "3.12.4",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.19",
    "lucide-react": "1.56.0",
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@geo-ie-accounting/config": "workspace:*",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.12.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
