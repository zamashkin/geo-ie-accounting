# Worker (apps/worker). Validated at boot by src/env.ts.
NODE_ENV=development
DATABASE_URL=postgres://ie_ledger:ie_ledger@localhost:5432/ie_ledger
LOG_LEVEL=info
LOG_PRETTY=true
SHUTDOWN_TIMEOUT_MS=30000
# Enqueue one noop job at boot to check the queue end to end.
WORKER_SMOKE_JOB=true
# Currencies rates.sync fetches daily (comma-separated ISO codes).
RATES_CURRENCIES=USD,EUR,GBP
