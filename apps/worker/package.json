{
  "name": "@geo-ie-accounting/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "ie-build-node-app src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@geo-ie-accounting/contracts": "workspace:*",
    "@geo-ie-accounting/db": "workspace:*",
    "@geo-ie-accounting/domain": "workspace:*",
    "@geo-ie-accounting/importers": "workspace:*",
    "@geo-ie-accounting/nbg": "workspace:*",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@geo-ie-accounting/config": "workspace:*",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
