# API (apps/api). Validated at boot by src/env.ts.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://ie_ledger:ie_ledger@localhost:5432/ie_ledger
LOG_LEVEL=info
LOG_PRETTY=true
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Local only. Production: `openssl rand -base64 32`, kept in the secret store.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Production with app.example.ge + api.example.ge: AUTH_COOKIE_DOMAIN=example.ge
# AUTH_COOKIE_DOMAIN=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=IE Ledger <no-reply@ie-ledger.local>
