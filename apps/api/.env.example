# API (apps/api). Validated at boot by src/env.ts.
NODE_ENV=development
HOST=0.0.0.0
PORT=4000
DATABASE_URL=postgres://geo_ie_accounting:geo_ie_accounting@localhost:5432/geo_ie_accounting
LOG_LEVEL=info
LOG_PRETTY=true
WEB_ORIGIN=http://localhost:3000
# STUB(WS-05): shared secret for POST /v1/rates/backfill (x-admin-token header), 32+ chars.
# Unset disables the route. Replaced by the real admin check when auth lands.
# ADMIN_TOKEN=
API_PUBLIC_URL=http://localhost:4000
# Local only. Production: `openssl rand -base64 32`, kept in the secret store.
BETTER_AUTH_SECRET=local-dev-secret-change-me-0123456789abcdef
# Production with app.example.ge + api.example.ge: AUTH_COOKIE_DOMAIN=example.ge
# AUTH_COOKIE_DOMAIN=
SMTP_URL=smtp://localhost:1025
MAIL_FROM=geo-ie-accounting <no-reply@geo-ie-accounting.local>
