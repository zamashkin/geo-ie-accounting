# Web (apps/web). Server-side variables, validated in src/env.ts.
API_URL=http://localhost:4000
# Browser-visible (inlined at build time), validated in src/lib/public-env.ts.
# The API as the browser sees it. Keep the same host as the web app (localhost, not 127.0.0.1)
# so the session cookie is shared (ADR 0011).
NEXT_PUBLIC_API_URL=http://localhost:4000
# `api` (default): real sign-in through Better Auth in the API. `mock`: local stand-in for UI work.
NEXT_PUBLIC_AUTH_MODE=api
